        [
          1,
          2,
          3,
          4,
          5
        ]
      ],
      "output": 15,
      "explanation": "1 + 2 + 3 + 4 + 5 = 15"
    },
    {
      "args": [
        []
      ],
      "output": 0,
      "explanation": "Danh sách rỗng có tổng bằng 0"
